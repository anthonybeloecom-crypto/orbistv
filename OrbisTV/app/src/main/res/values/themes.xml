<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="orbis_bg">#FF000000</color>

    <style name="Theme.Orbis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/orbis_bg</item>
        <item name="android:statusBarColor">@color/orbis_bg</item>
        <item name="android:navigationBarColor">@color/orbis_bg</item>
